{
  "name": "@scratchpadsh/mcp",
  "version": "1.0.0",
  "description": "MCP server for Scratchpad notes: search, read, write, and organize your notes from Claude, Cursor, Codex, and any MCP client.",
  "license": "MIT",
  "author": "Scratchpad (https://scratchpad.sh)",
  "homepage": "https://scratchpad.sh/ai/",
  "repository": { "type": "git", "url": "git+https://github.com/scratchpad-sh/mcp.git" },
  "keywords": ["mcp", "model-context-protocol", "notes", "scratchpad", "claude", "cursor", "ai"],
  "mcpName": "io.github.scratchpad-sh/scratchpad",
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": { "scratchpad-mcp-server": "dist/index.mjs" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
